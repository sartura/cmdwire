#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
export GOWORK=off

if [ "$#" -gt 1 ]; then
    echo "usage: $0 [CORPUS_DIR]" >&2
    exit 2
fi

corpus=${1:-"$(go env GOCACHE)/fuzz/github.com/sartura/cmdwire/FuzzParseLine"}
exec go run ./internal/fuzzreport "$corpus"
